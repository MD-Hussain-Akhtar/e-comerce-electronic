<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/output.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kerla English School | Home</title>
    <script src="https://cdn.tailwindcss.com"></script> <!-- Sirf testing ke liye agar output.css load na ho -->
</head>
<body class="bg-black text-white min-h-screen font-sans">

    <!-- Hero Section -->
    <div class="max-w-6xl mx-auto p-6 flex flex-col items-center">
        
        <!-- School Name -->
        <h1 class="text-amber-700 text-5xl md:text-7xl font-black text-center mt-10 mb-4 tracking-tighter  bg-clip-text bg-gradient-to-r from-orange-500 to-amber-300">
            WelCome TO APNA SCHOOL
        </h1>
        <p class="text-gray-400 text-lg mb-8 tracking-widest uppercase">Excellence in Education</p>

        <!-- The Iconic Line (Screenshot 2026-04-29 162925.png style) -->
        <div class="flex items-center w-full max-w-4xl mx-auto gap-x-0 mb-12">
            <div class="flex-grow flex items-center relative h-4">
                <div class="w-full h-[1px] bg-white/20"></div>
                <div class="absolute left-0 w-2.5 h-2.5 bg-[#f15a24] rounded-sm rotate-45 shadow-[0_0_10px_#f15a24]"></div>
                <div class="absolute right-0 w-2.5 h-2.5 bg-[#f15a24] rounded-sm rotate-45"></div>
            </div>

            <div class="flex-shrink-0 px-6">
                <div class="w-16 h-16 border-2 border-[#f15a24] rounded-2xl flex items-center justify-center rotate-6 bg-black shadow-[0_0_20px_rgba(241,90,36,0.3)]">
                    <span class="text-[#f15a24] text-4xl font-black -rotate-6">K</span>
                </div>
            </div>

            <div class="flex-grow flex items-center relative h-4">
                <div class="w-full h-[1px] bg-white/20"></div>
                <div class="absolute left-0 w-2.5 h-2.5 bg-[#f15a24] rounded-sm rotate-45"></div>
                <div class="absolute right-0 w-2.5 h-2.5 bg-[#f15a24] rounded-sm rotate-45 shadow-[0_0_10px_#f15a24]"></div>
            </div>
        </div>

        <!-- Dashboard Features / Navigation -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
            
            <!-- Feature 1: Add Student -->
            <a href="/AddStudent" class="group bg-gray-900 border border-white/5 p-8 rounded-3xl hover:border-orange-500/50 transition-all duration-300 transform hover:-translate-y-2 shadow-2xl">
                <div class="text-orange-500 mb-4 text-3xl">➔</div>
                <h3 class="text-xl font-bold mb-2 text-white group-hover:text-orange-500">Add Student</h3>
                <p class="text-gray-500 text-sm">Register new students into the school database system.</p>
            </a>

            <!-- Feature 2: Student List -->
            <a href="/AddStudent" class="group bg-gray-900 border border-white/5 p-8 rounded-3xl hover:border-blue-500/50 transition-all duration-300 transform hover:-translate-y-2 shadow-2xl">
                <div class="text-blue-500 mb-4 text-3xl">☰</div>
                <h3 class="text-xl font-bold mb-2 text-white group-hover:text-blue-500">Student List</h3>
                <p class="text-gray-500 text-sm">View, edit, and manage all currently enrolled students.</p>
            </a>

            <!-- Feature 3: Classes -->
            <div class="group bg-gray-900 border border-white/5 p-8 rounded-3xl hover:border-green-500/50 transition-all duration-300 transform hover:-translate-y-2 shadow-2xl">
                <div class="text-green-500 mb-4 text-3xl">◈</div>
                <h3 class="text-xl font-bold mb-2 text-white">Quick Class Links</h3>
                <div class="flex gap-2 mt-4">
                    <a href="/class/9" class="text-xs bg-gray-800 px-3 py-1 rounded-full hover:bg-green-600 transition">9th</a>
                    <a href="/class/10th" class="text-xs bg-gray-800 px-3 py-1 rounded-full hover:bg-green-600 transition">10th</a>
                    <a href="/class/11th" class="text-xs bg-gray-800 px-3 py-1 rounded-full hover:bg-green-600 transition">11th</a>
                </div>
            </div>

        </div>

        <!-- Footer Footer -->
        <footer class="mt-20 text-gray-600 text-sm">
            &copy; 2026 Kerla English School Management System.
        </footer>

    </div>
</body>
</html>